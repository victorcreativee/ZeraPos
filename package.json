{
  "name": "zerapos",
  "version": "1.0.0",
  "main": "desktop/main.cjs",
  "author": "",
  "description": "Restaurant POS desktop application",
  "scripts": {
    "frontend": "cd frontend && npm run dev",
    "backend": "cd backend && npm run dev",
    "desktop": "concurrently \"npm run frontend\" \"wait-on http://localhost:5173 && electron desktop/main.cjs\"",
    "build:frontend": "cd frontend && npm run build",
    "build:backend": "cd backend && npm ci --omit=dev",
    "desktop:build": "npm run build:frontend && npm run build:backend && electron-builder",
    "desktop:build:mac": "npm run build:frontend && npm run build:backend && electron-builder --mac dmg"
  },
  "build": {
    "appId": "com.zera.pos",
    "productName": "Zera POS",
    "directories": {
      "output": "release"
    },
    "asar": true,
    "files": [
      "desktop/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "frontend/dist",
        "to": "frontend/dist"
      },
      {
        "from": "backend/src",
        "to": "backend/src"
      },
      {
        "from": "backend/package.json",
        "to": "backend/package.json"
      },
      {
        "from": "backend/package-lock.json",
        "to": "backend/package-lock.json"
      },
      {
        "from": "backend/node_modules",
        "to": "backend/node_modules",
        "filter": [
          "**/*",
          "!nodemon/**",
          "!.cache/**"
        ]
      }
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.business"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/victorcreativee/ZeraPos.git"
  },
  "keywords": [],
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/victorcreativee/ZeraPos/issues"
  },
  "homepage": "https://github.com/victorcreativee/ZeraPos#readme",
  "devDependencies": {
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3",
    "wait-on": "^9.0.10"
  }
}
